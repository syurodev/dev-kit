<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dev-kit"
        Arguments=""
        InstallLocation="C:\Program Files\syurodev\DevKit">
    </Installer>
    <PackageInformation
        PackageName="DevKit"
        PackageDisplayName="DevKit"
        PublisherName="CN=syurodev"
        PublisherDisplayName="syurodev"
        Version="0.1.0.0"
        PackageDescription="Local-first developer toolkit">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.syuro.devkit"
                Description="Local-first developer toolkit"
                DisplayName="DevKit"
                ExecutableName="dev-kit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>DevKit</DisplayName>
            <PublisherDisplayName>syurodev</PublisherDisplayName>
            <Description>Local-first developer toolkit</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dev-kit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
